{
	// https://developers.cloudflare.com/workers/wrangler/configuration/
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "imigresen-automerge-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-05-08",
	"compatibility_flags": ["nodejs_compat"],
	"dev": {
		// https://github.com/cloudflare/workers-sdk/issues/6587#issuecomment-2576937634
		"ip": "127.0.0.1",
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA",
	},
	"env": {
		"development": {
			"vars": {
				"AUTHNZ_JWK_URL": "https://authnz.skulpture.xyz/realms/imigresen/protocol/openid-connect/certs",
				"WORKER_ENVIRONMENT": "development",
				"ALLOWED_ORIGINS": "https://dev.imigresen.skulpture.xyz, http://localhost:5173, https://imigresen.pages.dev",
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "db3ff5e1668d4851815ac10e227e3dfa",
					"localConnectionString": "postgresql://test:test@postgres/test?sslmode=disable",
				},
			],
			"version_metadata": {
				"binding": "CF_VERSION_METADATA",
			},
			"routes": [
				{
					"pattern": "automerge-api-dev.imigresen.skulpture.xyz",
					"custom_domain": true,
				},
			],
			"unsafe": {
				"bindings": [
					{
						"name": "AUTOMERGE_RATE_LIMIT",
						"type": "ratelimit",
						"namespace_id": "1234",
						"simple": {
							"limit": 25,
							"period": 60,
						},
					},
				],
			},
		},
		"production": {
			"vars": {
				"AUTHNZ_JWK_URL": "https://authnz.skulpture.xyz/realms/imigresen/protocol/openid-connect/certs",
				"WORKER_ENVIRONMENT": "production",
				"ALLOWED_ORIGINS": "https://imigresen.skulpture.xyz",
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "b75d0ed9a01c41939a4da1d35514501c",
				},
			],
			"version_metadata": {
				"binding": "CF_VERSION_METADATA",
			},
			"routes": [
				{
					"pattern": "automerge-api-master.imigresen.skulpture.xyz",
					"custom_domain": true,
				},
			],
			"unsafe": {
				"bindings": [
					{
						"name": "AUTOMERGE_RATE_LIMIT",
						"type": "ratelimit",
						"namespace_id": "4321",
						"simple": {
							"limit": 125,
							"period": 60,
						},
					},
				],
			},
		},
	},
}
