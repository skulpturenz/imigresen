{
	// https://developers.cloudflare.com/workers/wrangler/configuration/
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "imigresen-automerge-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-05-08",
	"compatibility_flags": ["nodejs_compat"],
	"dev": {
		// https://github.com/cloudflare/workers-sdk/issues/6587#issuecomment-2576937634
		"ip": "127.0.0.1",
	},
	"env": {
		"development": {
			"vars": {
				"WORKER_ENVIRONMENT": "development",
				"ALLOWED_ORIGINS": "https://dev.imigresen.skulpture.xyz, http://localhost:5173, https://imigresen.pages.dev",
				"OIDC_REDIRECT_URL": "https://imigresen-automerge-api-development.yb76qksbc8.workers.dev/callback",
				// "OIDC_REDIRECT_URL": "http://localhost:8787/callback", // locally
				// "OIDC_REDIRECT_URL": "https://automerge-api-dev.imigresen.skulpture.xyz/callback", // TODO
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "82f8c83479c04996af7154a0a68a042c",
					"localConnectionString": "postgresql://test:test@postgres/test?sslmode=disable",
				},
			],
		},
		"production": {
			"vars": {
				"WORKER_ENVIRONMENT": "production",
				"ALLOWED_ORIGINS": "https://imigresen.skulpture.xyz",
				"OIDC_REDIRECT_URL": "https://automerge-api-master.imigresen.skulpture.xyz/callback",
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "b75d0ed9a01c41939a4da1d35514501c",
				},
			],
		},
	},
}
