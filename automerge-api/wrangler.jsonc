{
	// https://developers.cloudflare.com/workers/wrangler/configuration/
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "imigresen-automerge-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-05-08",
	"compatibility_flags": ["nodejs_compat"],
	"dev": {
		// https://github.com/cloudflare/workers-sdk/issues/6587#issuecomment-2576937634
		"ip": "127.0.0.1",
		// TODO: testing deployed version first
		// "local_protocol": "https",
	},
	"env": {
		"development": {
			"vars": {
				"WORKER_ENVIRONMENT": "development",
				"ALLOWED_ORIGINS": "https://dev.imigresen.skulpture.xyz, http://localhost:5173",
				"PG_CONNECTION_STRING": "postgresql://test:test@postgres/test?sslmode=disable",
			},
		},
		"production": {
			"vars": {
				"WORKER_ENVIRONMENT": "production",
				"ALLOWED_ORIGINS": "https://imigresen.skulpture.xyz",
			},
		},
	},
}
