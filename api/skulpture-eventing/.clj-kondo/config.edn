{:linters {:unsorted-required-namespaces {:level :error}
           :refer {:level :warning}
           :single-key-in {:level :ignore}
           :used-underscored-binding {:level :error}
           :unused-value {:level :warning}
           :redundant-call {:level :warning}
           :redundant-str-call {:level :warning}
           :duplicate-require {:level :warning}
           :unresolved-namespace {:level :error}}
 :lint-as {mount.core/defstate clj-kondo.lint-as/def-catch-all}
 :parallel true}
